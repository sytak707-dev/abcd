# Notion API 설정
# 1. https://www.notion.so/my-integrations 에서 Integration 생성 후 API Key 복사
# 2. Notion 데이터베이스를 생성하고 아래 속성을 추가:
#    - 이름 (Title)
#    - 이메일 (Email)
#    - 업종 (Text)
#    - 마케팅방식 (Select: 에이전시 이용중 / 인하우스 / 직접 운영 중)
# 3. 데이터베이스 우측 상단 ··· > Connections > 생성한 Integration 연결
# 4. 데이터베이스 URL에서 ID 복사 (notion.so/workspace/[DATABASE_ID]?v=...)

NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
